---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = new Map<number, string>();
const publishers = new Map<number, string>();

for (const game of games) {
  if (game.category) categories.set(game.category.id, game.category.name);
  if (game.publisher) publishers.set(game.publisher.id, game.publisher.name);
}

const categoryOptions = [...categories].map(([id, name]) => ({ id, name }))
  .sort((first, second) => first.name.localeCompare(second.name));
const publisherOptions = [...publishers].map(([id, name]) => ({ id, name }))
  .sort((first, second) => first.name.localeCompare(second.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      {games.length > 0 && (
        <form
          class="mb-8 rounded-xl border border-slate-700 bg-slate-900/60 p-5"
          aria-label="Game filters"
          data-testid="game-filters"
        >
          <div class="grid items-end gap-6 md:grid-cols-[2fr_1fr_1fr_auto]">
            <div>
              <label class="mb-2 block font-medium text-slate-100" for="game-title-search">
                Search by game title
              </label>
              <input
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                type="search"
                id="game-title-search"
                name="title"
                data-testid="game-title-search"
              />
            </div>

            <fieldset>
              <legend class="mb-3 font-medium text-slate-100">Categories</legend>
              <div class="flex flex-wrap gap-x-5 gap-y-3">
                {categoryOptions.map((category) => (
                  <label class="flex items-center gap-2 text-slate-200" for={`category-filter-${category.id}`}>
                    <input
                      class="rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      type="checkbox"
                      name="categoryIds"
                      value={category.id}
                      id={`category-filter-${category.id}`}
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label class="mb-2 block font-medium text-slate-100" for="publisher-filter">Publisher</label>
              <select
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                id="publisher-filter"
                name="publisherId"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publisherOptions.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              type="button"
              data-testid="clear-game-filters"
            >
              Clear filters
            </button>
          </div>
          <p class="mt-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-results-status">
            Showing all {games.length} games.
          </p>
        </form>
      )}

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          <div class="col-span-full" data-testid="game-search-empty-state" hidden>
            <EmptyState text="No games match your search and selected filters." />
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (filterForm && gamesGrid) {
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const categoryInputs = Array.from(
      filterForm.querySelectorAll<HTMLInputElement>('input[name="categoryIds"]'),
    );
    const titleSearch = filterForm.querySelector<HTMLInputElement>('[name="title"]');
    const publisherSelect = filterForm.querySelector<HTMLSelectElement>('[name="publisherId"]');
    const resultsStatus = filterForm.querySelector<HTMLElement>('[data-testid="filter-results-status"]');
    const emptyState = gamesGrid.querySelector<HTMLElement>('[data-testid="game-search-empty-state"]');
    const clearButton = filterForm.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');

    const updateVisibleGames = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const normalizedTitle = titleSearch?.value.trim().toLowerCase() ?? '';
      const selectedPublisher = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const titleMatches = (card.dataset.gameTitle ?? '').toLowerCase().includes(normalizedTitle);
        const categoryMatches =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
        const isVisible = titleMatches && categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        if (isVisible) visibleCount++;
      }

      if (emptyState) emptyState.hidden = visibleCount !== 0;
      if (resultsStatus) {
        resultsStatus.textContent =
          visibleCount === 0
            ? 'No games match your search and selected filters.'
            : `Showing ${visibleCount} of ${gameCards.length} games.`;
      }
    };

    filterForm.addEventListener('submit', (event) => event.preventDefault());
    filterForm.addEventListener('change', updateVisibleGames);
    titleSearch?.addEventListener('input', updateVisibleGames);
    clearButton?.addEventListener('click', () => {
      if (titleSearch) titleSearch.value = '';
      for (const input of categoryInputs) input.checked = false;
      if (publisherSelect) publisherSelect.value = '';
      updateVisibleGames();
    });
  }
</script>
